# Entorno general
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WEB_HOST=0.0.0.0
WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000

# PostgreSQL
POSTGRES_USER=atelier
POSTGRES_PASSWORD=CAMBIAR_EN_EL_SERVIDOR
POSTGRES_DB=atelier_lumiere
DATABASE_URL=postgresql://atelier:CAMBIAR_EN_EL_SERVIDOR@database:5432/atelier_lumiere
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Migraciones incrementales
# El servicio migrate registra nombre, versión y SHA-256 antes de arrancar la API.
MIGRATION_STATEMENT_TIMEOUT_MS=120000
MIGRATION_LOCK_TIMEOUT_MS=10000

# Sesiones y autenticación
AUTH_SECRET=GENERAR_CLAVE_LARGA_EN_EL_MINI_PC
AUTH_LOGIN_PEPPER=GENERAR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUTH_SERVICE_USER_ID=00000000-0000-4000-8000-000000000008
PROVIDER_LOGIN_CHALLENGE_TTL_MINUTES=10
PROVIDER_SESSION_TTL_HOURS=12
ADMIN_LOGIN_CHALLENGE_TTL_MINUTES=10
ADMIN_SESSION_TTL_HOURS=8
PROVIDER_COOKIE_SECURE=false

# Administración real
# Activa las páginas administrativas. Requiere una cuenta real en PostgreSQL con contraseña y 2FA.
ENABLE_ADMIN_UI=false
# Debe ser true cuando la web se publique exclusivamente mediante HTTPS.
WEB_COOKIE_SECURE=false

# Acceso administrativo temporal exclusivo de la API en desarrollo
# No lo utiliza la pantalla web y nunca funciona con NODE_ENV=production.
ALLOW_DEV_ADMIN_AUTH=false
DEV_ADMIN_TOKEN=GENERAR_TOKEN_ALEATORIO_DE_AL_MENOS_32_CARACTERES
DEV_ADMIN_USER_ID=00000000-0000-4000-8000-000000000001
DEV_ADMIN_EMAIL=admin@atelier.localhost
DEV_ADMIN_DISPLAY_NAME=Administración Atelier Lumière

# Recuperación de cuentas
# Los enlaces son de un solo uso y todas las sesiones anteriores se revocan al completar el cambio.
PASSWORD_RESET_TTL_MINUTES=30
TWO_FACTOR_RESET_TTL_MINUTES=30
ACCOUNT_RECOVERY_COOLDOWN_SECONDS=300
# Administración sustituye contraseña, TOTP y códigos de recuperación en un único proceso.
ADMIN_RECOVERY_TTL_MINUTES=30
ADMIN_RECOVERY_COOLDOWN_SECONDS=300

# Legal y privacidad
# Identificador técnico, no es una cuenta humana ni una credencial.
LEGAL_SERVICE_USER_ID=00000000-0000-4000-8000-000000000007
# En producción solo se sirven documentos marcados como ACTIVE y revisados profesionalmente.
# La cookie de preferencias hereda WEB_COOKIE_SECURE y debe quedar en true bajo HTTPS.

# Checkout piloto sin pago real
# Requiere NODE_ENV=development y ALLOW_DEV_ADMIN_AUTH=true para utilizar el contexto interno del piloto.
# El servidor recalcula precios, exige un único taller por checkout y reserva stock; nunca recibe datos de tarjeta.
PILOT_CHECKOUT_ENABLED=false
# Gastos de envío provisionales aplicados una sola vez al taller del checkout, en céntimos.
PILOT_SHIPPING_CENTS=0

# Correo de invitaciones, verificación, recuperación y acceso a pedidos
# Mantener false hasta configurar y comprobar el servidor SMTP.
SMTP_ENABLED=false
SMTP_VERIFY_ON_START=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Puerto 465: SMTP_SECURE=true. Puerto 587: SMTP_SECURE=false y SMTP_REQUIRE_TLS=true.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=correo@example.com
SMTP_PASSWORD=CAMBIAR_EN_EL_SERVIDOR
SMTP_FROM=Atelier Lumière <correo@example.com>
SMTP_REPLY_TO=correo@example.com
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Doble factor obligatorio
TWO_FACTOR_SETUP_TTL_MINUTES=15
# Generar con: openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY_BASE64=GENERAR_CLAVE_BASE64_DE_32_BYTES
TWO_FACTOR_RECOVERY_PEPPER=GENERAR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Almacenamiento multimedia privado
STORAGE_DRIVER=local
STORAGE_PATH=/data/media
# Tiempo máximo para completar una carga reservada en PostgreSQL.
MEDIA_UPLOAD_TTL_MINUTES=15
MAX_IMAGE_MB=12
MAX_VIDEO_MB=50
MAX_IMAGES_PER_PRODUCT=8

# Seguridad
REQUIRE_PROVIDER_2FA=true
INVITATION_TTL_HOURS=48
