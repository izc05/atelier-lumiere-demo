FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV WEB_HOST=0.0.0.0
ENV WEB_PORT=3000

COPY source/apps/web ./apps/web
COPY index.html /demo/index.html
COPY _next /demo/_next
COPY images /demo/images
COPY assets /demo/assets

RUN node apps/web/scripts/prepare-original-home.mjs /demo /app/apps/web/public \
  && node apps/web/scripts/prepare-premium-ui.mjs /app/apps/web/public \
  && find /app/apps/web/public -type d -exec chmod 755 {} + \
  && find /app/apps/web/public -type f -exec chmod 644 {} + \
  && rm -rf /demo

EXPOSE 3000

USER node
CMD ["node", "apps/web/src/server.mjs"]
