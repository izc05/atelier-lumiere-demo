FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
ENV API_PORT=4000
ENV STORAGE_PATH=/data/media
ENV MIGRATIONS_PATH=/app/migrations

COPY apps/api/package.json ./package.json
RUN npm install --omit=dev --ignore-scripts \
  && npm rebuild sharp \
  && npm cache clean --force

COPY apps/api/src ./src
COPY packages/database/migrations ./migrations

RUN find /app/src /app/migrations -type d -exec chmod 755 {} + \
  && find /app/src /app/migrations -type f -exec chmod 644 {} + \
  && mkdir -p /data/media/.tmp \
  && chown -R node:node /data/media

EXPOSE 4000

USER node
CMD ["node", "src/server.mjs"]
